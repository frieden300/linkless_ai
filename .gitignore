# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ─────────────────────────────────────────────
# Linkless AI — project-specific exclusions
# ─────────────────────────────────────────────

# GGUF model weights (too large for GitHub; distributed via Hugging Face)
/models/
*.gguf

# llama.cpp pre-built binaries (distributed via GitHub releases / download script)
/llama-cpp/

# Internal training/dataset images (not part of the public app)
/bundle images/

# Internal college project documents
*.docx
*.doc

# Fine-tuning notebook (linked separately; not part of the Flutter app repo)
*.ipynb

# Scratch / notes files
help.txt
/TESTING/
/AGENTS.md

# Windows run-server shortcut (user-specific)
run server cmd

# Release-only setup script (bundled in GitHub Releases, not repo)
setup_release.bat

# Screen recording raw captures and video sources (large media)
*.stg
docs/*.mp4